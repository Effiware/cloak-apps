ENV=docker

SERVER_PORT=8080
TEMPL_PROXY_PORT=8081
KEYCLOAK_PORT=8082

# Observability stack — Grafana is the only UI; Loki/Tempo/Alloy are exposed for debugging.
GRAFANA_PORT=8083
PROMETHEUS_PORT=8084
LOKI_PORT=8085
TEMPO_PORT=8086
ALLOY_PORT=8087

# Where the app sends OTLP; Alloy fans out to Tempo.
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Stands in for the K8s namespace so the contract's LogQL queries work locally.
LOG_NAMESPACE=dev-v1
