                    <a href="https://prometheus.company.com" class="block group">
                        <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg transition-shadow">
                            <div class="flex items-start space-x-4">
                                <div class="flex-shrink-0">
                                    <div class="h-12 w-12 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center">
                                        <span class="text-2xl">🔥</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
