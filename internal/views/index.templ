                                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Monitoring system and time series database</p>
                                </div>
                            </div>
                        </div>
                    </a>

                    <!-- Grafana Card -->
                    <a href="https://grafana.company.com" class="block group">
